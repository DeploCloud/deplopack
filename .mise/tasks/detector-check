#!/usr/bin/env bash
#MISE description="Verify detector matches, paths, configuration and failure output"
set -euo pipefail
mkdir -p tmp
go build -o tmp/deplopack-detector ./cmd/detector
python3 - <<'PY'
import json
import subprocess
import tempfile
from pathlib import Path

binary = str(Path('tmp/deplopack-detector').resolve())

def analyze(root, *args, success=True):
    run = subprocess.run([binary, *args, str(root)], capture_output=True, text=True)
    assert (run.returncode == 0) == success, run.stderr
    result = json.loads(run.stdout)
    assert result['success'] == success, result
    return result

with tempfile.TemporaryDirectory(dir='tmp') as directory:
    root = Path(directory)
    empty = analyze(root)
    assert empty['detections'] == [], empty
    assert set(empty) <= {'success', 'detections', 'logs'}, empty
    (root / 'railpack.json').write_text('{"provider":"node"}')
    assert analyze(root)['detections'] == [], 'Configured providers must not become detections'
    (root / 'railpack.json').unlink()
    # Each marker exercises an upstream provider; shared repos must retain every match.
    for name in ['index.php', 'go.mod', 'pom.xml', 'Cargo.toml', 'Gemfile',
                 'mix.exs', 'main.py', 'deno.json', 'app.csproj', 'package.json',
                 'gleam.toml', 'CMakeLists.txt', 'index.html', 'start.sh']:
        (root / name).write_text('{}' if name.endswith('.json') else '')
    result = analyze(root)
    expected = ['php', 'golang', 'java', 'rust', 'ruby', 'Elixir', 'python',
                'deno', 'Dotnet', 'node', 'gleam', 'cpp', 'staticfile', 'shell']
    assert result['detections'] == [{'type': name} for name in expected], result
    (root / 'Dockerfile').write_text('FROM scratch\n')
    for name in ['compose.yaml', 'compose.yml', 'docker-compose.yaml', 'docker-compose.yml']:
        (root / name).write_text('services: {}\n')
    result = analyze(root)
    assert result['detections'][14:] == [
        {'type': 'dockerfile', 'path': 'Dockerfile'},
        *[{'type': 'compose', 'path': name} for name in
          ['compose.yaml', 'compose.yml', 'docker-compose.yaml', 'docker-compose.yml']]
    ], result
    # Standard names precede variants; equal priorities sort by depth, then path.
    variants = ['compose.prod.yml', 'compose.dev.yaml', 'docker-compose.dev.yml',
                'deploy/compose.yaml', 'deploy/compose.dev.yaml',
                'deploy/deep/compose.yaml']
    for name in variants:
        file = root / name
        file.parent.mkdir(parents=True, exist_ok=True)
        file.write_text('services: {}\n')
    (root / 'compose.txt').write_text('not Compose')
    (root / 'compose.fake.yaml').mkdir()
    (root / '.dockerignore').write_text('**/compose*\n**/docker-compose*\n')
    result = analyze(root)
    assert [item['path'] for item in result['detections'] if item['type'] == 'compose'] == [
        'compose.yaml', 'deploy/compose.yaml', 'deploy/deep/compose.yaml',
        'compose.yml', 'docker-compose.yaml', 'docker-compose.yml',
        'compose.dev.yaml', 'compose.prod.yml', 'docker-compose.dev.yml',
        'deploy/compose.dev.yaml'
    ], result
    (root / '.dockerignore').write_text('*.csproj\n')
    assert {'type': 'Dotnet'} not in analyze(root)['detections']
    (root / 'railpack.json').write_text('{"provider":"node","exclude":["!*.csproj"]}')
    result = analyze(root)
    assert {'type': 'Dotnet'} in result['detections'], result
    (root / 'start.sh').unlink()
    (root / 'custom.sh').write_text('')
    assert {'type': 'shell'} not in analyze(root)['detections']
    assert {'type': 'shell'} in analyze(root, '-env', 'RAILPACK_SHELL_SCRIPT=custom.sh')['detections']
    (root / 'railpack.json').write_text('{broken')
    analyze(root, success=False)
print('Detector checks passed')
PY
